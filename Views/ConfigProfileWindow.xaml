<?xml version="1.0" encoding="utf-8"?>

<Window x:Class="XrayUI.Views.ConfigProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:CommunityToolkit.WinUI.Controls"
        mc:Ignorable="d"
        Title="配置文件">

    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Slot picker -->
        <StackPanel Grid.Row="0"
                    Padding="20,20,20,12"
                    Spacing="8">
            <TextBlock x:Uid="ConfigProfile_Header"
                       Text="配置文件"
                       Style="{ThemeResource SubtitleTextBlockStyle}" />
            <!-- Which slot, and whether that slot is on, are one decision — keeping them on a
                 single line says so, and spares the editor a whole row of chrome. -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <controls:Segmented Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    SelectedIndex="{x:Bind ViewModel.SelectedSlotIndex, Mode=TwoWay}">
                    <controls:Segmented.Resources>
                        <SolidColorBrush x:Key="SegmentedItemBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="SegmentedItemBorderBrushPointerOver" Color="Transparent" />
                    </controls:Segmented.Resources>
                    <!-- Order matches ConfigProfileViewModel's slot indices. -->
                    <controls:SegmentedItem x:Uid="ConfigProfile_SlotProxy" Content="系统代理" />
                    <controls:SegmentedItem x:Uid="ConfigProfile_SlotTun" Content="TUN 模式" />
                </controls:Segmented>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <TextBlock x:Uid="ConfigProfile_EnableTitle"
                               Text="使用自定义配置"
                               VerticalAlignment="Center" />
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsProfileEnabled, Mode=TwoWay}"
                                  OnContent=""
                                  OffContent=""
                                  MinWidth="0"
                                  VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <TextBlock x:Uid="ConfigProfile_Subtitle"
                       Text="不要写 outbounds：出站由服务器列表中选中的节点生成。"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Opacity="0.65" />
        </StackPanel>

        <InfoBar Grid.Row="1"
                 Margin="20,0,20,12"
                 IsOpen="{x:Bind ViewModel.IsValidationOpen, Mode=OneWay}"
                 Severity="{x:Bind ViewModel.ValidationSeverity, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                 IsClosable="False" />

        <!-- Header is the literal xray section shape, not prose — deliberately untranslated,
             same as the "XHTTP Mode" header in the edit-server dialog. -->
        <TextBox x:Name="EditorTextBox"
                 Grid.Row="2"
                 Margin="20,0,20,0"
                 Header="config.json (outbounds excluded)"
                 Text="{x:Bind ViewModel.EditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 IsSpellCheckEnabled="False"
                 IsTextPredictionEnabled="False"
                 FontFamily="Consolas"
                 FontSize="13"
                 VerticalContentAlignment="Top"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />

        <Border Grid.Row="3"
                Margin="0,16,0,0"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Padding="20,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="OpenFolderButton"
                            Command="{x:Bind ViewModel.OpenFolderCommand}">
                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                    </Button>
                    <Button x:Name="PreviewButton"
                            Command="{x:Bind ViewModel.PreviewCommand}">
                        <FontIcon Glyph="&#xE8FF;" FontSize="14" />
                    </Button>
                    <Button x:Uid="ConfigProfile_ResetBtn"
                            Content="重置为默认"
                            Command="{x:Bind ViewModel.ResetToDefaultCommand}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="ConfigProfile_SaveBtn"
                            Style="{ThemeResource AccentButtonStyle}"
                            MinWidth="80"
                            Content="保存"
                            Command="{x:Bind ViewModel.SaveCommand}" />
                    <Button x:Uid="ConfigProfile_CloseBtn"
                            MinWidth="80"
                            Content="关闭"
                            Command="{x:Bind ViewModel.CloseCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
