<?xml version="1.0" encoding="utf-8"?>

<Window x:Class="XrayUI.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="代理日志">

    <Grid x:Name="WindowRoot" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar — registered via SetTitleBar() in code-behind; Title set there via L.* -->
        <TitleBar x:Name="AppTitleBar" Grid.Row="0">
            <TitleBar.IconSource>
                <FontIconSource  Glyph="&#xE9D9;" />
            </TitleBar.IconSource>
        </TitleBar>
        
        <ScrollView x:Name="LogScrollViewer"
                    Grid.Row="1"
                    ContentOrientation="Both"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto">
            <TextBlock x:Name="LogTextBlock"
                       Margin="12,12,12,16"
                       FontFamily="Cascadia Code, Consolas, Courier New"
                       FontSize="12"
                       LineHeight="20"
                       LineStackingStrategy="BlockLineHeight"
                       IsTextSelectionEnabled="True"
                       TextWrapping="NoWrap"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </ScrollView>

        <!-- Code-created Runs can't reference {ThemeResource} directly, and
             Application.Current.Resources[key] would resolve system brushes
             against the (never-set) app-level theme instead of this window's
             tracked theme — so this real, collapsed element carries the brush,
             correctly inheriting WindowRoot's theme. Re-read on ActualThemeChanged. -->
        <TextBlock x:Name="TimestampBrushSource"
                   Grid.Row="1"
                   Visibility="Collapsed"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

        <!-- Toolbar -->
        <Border Grid.Row="2"
                Padding="12,8"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <!-- Status -->
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot"
                             Width="8" Height="8"
                             VerticalAlignment="Center"
                             Fill="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock x:Name="StatusText"
                               Text="未运行"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="LineCountText"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button x:Name="RouteTestButton"
                            Padding="8,5">
                        <FontIcon Glyph="&#xF196;"
                                  FontSize="13" />
                        <Button.Flyout>
                            <Flyout Opened="RouteTestFlyout_Opened">
                                <!-- Fixed width: without it the detail text never wraps. -->
                                <StackPanel Width="300"
                                            Spacing="12">
                                    <StackPanel.Resources>
                                        <Style x:Key="RouteTestBadgeTextStyle"
                                               TargetType="TextBlock">
                                            <Setter Property="Margin" Value="8,2" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                    </StackPanel.Resources>
                                    <TextBlock x:Name="RouteTestTitle"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">
                                        <TextBox x:Name="RouteTestInput"
                                                 KeyDown="RouteTestInput_KeyDown" />
                                        <Button x:Name="RouteTestRunButton"
                                                Grid.Column="1"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Click="RouteTestRunButton_Click" />
                                    </Grid>
                                    <!-- Result: one badge per outbound kind so each keeps its
                                         ThemeResource brushes across theme switches. -->
                                    <Grid x:Name="RouteTestResultRow"
                                          ColumnDefinitions="Auto,*"
                                          ColumnSpacing="8"
                                          Visibility="Collapsed">
                                        <Grid VerticalAlignment="Center">
                                            <ProgressRing x:Name="RouteTestProgress"
                                                          Width="16"
                                                          Height="16"
                                                          IsActive="False"
                                                          Visibility="Collapsed" />
                                            <!-- No stock brush is an accent (or neutral) tint:
                                                 SystemFillColorAttentionBackgroundBrush is a
                                                 near-transparent neutral, so these two badges
                                                 fade a solid fill behind the text instead. -->
                                            <Grid x:Name="RouteTestProxyBadge"
                                                  Visibility="Collapsed">
                                                <Rectangle RadiusX="4"
                                                           RadiusY="4"
                                                           Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                           Opacity="0.15" />
                                                <TextBlock x:Name="RouteTestProxyText"
                                                           Style="{StaticResource RouteTestBadgeTextStyle}"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Grid>
                                            <Border x:Name="RouteTestDirectBadge"
                                                    CornerRadius="4"
                                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                    Visibility="Collapsed">
                                                <TextBlock x:Name="RouteTestDirectText"
                                                           Style="{StaticResource RouteTestBadgeTextStyle}"
                                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            </Border>
                                            <Border x:Name="RouteTestBlockBadge"
                                                    CornerRadius="4"
                                                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                                    Visibility="Collapsed">
                                                <TextBlock x:Name="RouteTestBlockText"
                                                           Style="{StaticResource RouteTestBadgeTextStyle}"
                                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </Border>
                                            <Grid x:Name="RouteTestOtherBadge"
                                                  Visibility="Collapsed">
                                                <Rectangle RadiusX="4"
                                                           RadiusY="4"
                                                           Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Opacity="0.15" />
                                                <TextBlock x:Name="RouteTestOtherText"
                                                           Style="{StaticResource RouteTestBadgeTextStyle}" />
                                            </Grid>
                                        </Grid>
                                        <TextBlock x:Name="RouteTestDetail"
                                                   Grid.Column="1"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="LogPrivacyButton"
                            Padding="8,5">
                        <FontIcon Glyph="&#xE72E;"
                                  FontSize="13" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutSubItem x:Name="MaskAddressSubMenu" Text="IP地址遮罩">
                                    <RadioMenuFlyoutItem x:Name="MaskOffMenuItem"
                                                         Text="关闭"
                                                         GroupName="LogMaskAddressGroup"
                                                         Tag="off"
                                                         Click="MaskAddressMenuItem_Click" />
                                    <RadioMenuFlyoutItem x:Name="MaskQuarterMenuItem"
                                                         Text="quarter"
                                                         GroupName="LogMaskAddressGroup"
                                                         Tag="quarter"
                                                         Click="MaskAddressMenuItem_Click" />
                                    <RadioMenuFlyoutItem x:Name="MaskHalfMenuItem"
                                                         Text="half"
                                                         GroupName="LogMaskAddressGroup"
                                                         Tag="half"
                                                         Click="MaskAddressMenuItem_Click" />
                                    <RadioMenuFlyoutItem x:Name="MaskFullMenuItem"
                                                         Text="full"
                                                         GroupName="LogMaskAddressGroup"
                                                         Tag="full"
                                                         Click="MaskAddressMenuItem_Click" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSubItem x:Name="LogLevelSubMenu" Text="日志级别">
                                    <RadioMenuFlyoutItem x:Name="LogLevelDebugMenuItem"
                                                         Text="Debug"
                                                         GroupName="LogLevelGroup"
                                                         Tag="debug"
                                                         Click="LogLevelMenuItem_Click" />
                                    <RadioMenuFlyoutItem x:Name="LogLevelInfoMenuItem"
                                                         Text="Info"
                                                         GroupName="LogLevelGroup"
                                                         Tag="info"
                                                         Click="LogLevelMenuItem_Click" />
                                    <RadioMenuFlyoutItem x:Name="LogLevelWarningMenuItem"
                                                         Text="Warning"
                                                         GroupName="LogLevelGroup"
                                                         Tag="warning"
                                                         Click="LogLevelMenuItem_Click" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSubItem x:Name="DnsLogSubMenu" Text="DNS 查询日志">
                                    <RadioMenuFlyoutItem x:Name="DnsLogOffMenuItem"
                                                         Text="关闭"
                                                         GroupName="DnsLogGroup"
                                                         Tag="off"
                                                         Click="DnsLogMenuItem_Click" />
                                    <RadioMenuFlyoutItem x:Name="DnsLogOnMenuItem"
                                                         Text="开启"
                                                         GroupName="DnsLogGroup"
                                                         Tag="on"
                                                         Click="DnsLogMenuItem_Click" />
                                </MenuFlyoutSubItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <ToggleButton x:Name="AutoScrollToggle"
                                  IsChecked="True"
                                  FontSize="12"
                                  Padding="10,5" />
                    <Button x:Name="CopyButton"
                            FontSize="12"
                            Padding="10,5"
                            Click="CopyButton_Click" />
                    <Button x:Name="ClearButton"
                            FontSize="12"
                            Padding="10,5"
                            Click="ClearButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
